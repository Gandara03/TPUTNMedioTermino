            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Martina\",\n  \"apellido\": \"López\",\n  \"cuit\": \"27384567210\",\n  \"email\": \"martina.lopez@gmail.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const u = pm.response.json();",
                  "pm.collectionVariables.set(\"usuario_id\", u.id);",
                  "pm.collectionVariables.set(\"cuit_usado\", u.cuit);",
                  "pm.test(\"Tiene id\", () => pm.expect(u.id).to.be.a(\"number\"));"
