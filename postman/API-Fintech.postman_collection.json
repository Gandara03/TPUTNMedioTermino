              "mode": "raw",
              "raw": "{\n  \"tipo\": \"CAJA_AHORRO\",\n  \"numero\": \"CA-{{$timestamp}}\",\n  \"usuarioId\": {{usuario_id}},\n  \"saldoInicial\": 154000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const c = pm.response.json();",
                  "pm.collectionVariables.set(\"caja_id\", c.id);",
                  "pm.test(\"Es caja de ahorro\", () => pm.expect(c.tipo).to.eql(\"CAJA_AHORRO\"));",
                  "pm.test(\"Limite = saldo\", () => pm.expect(c.limiteRetiro).to.eql(c.saldo));"
                ]
              }
            }
          ]
        },
