    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "usuario_id",
      "value": ""
    },
    {
      "key": "caja_id",
      "value": ""
    },
    {
      "key": "cc_id",
      "value": ""
    },
    {
      "key": "cuenta_vacia_id",
      "value": ""
    },
    {
      "key": "dni_usado",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Usuarios",
      "item": [
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/usuarios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Gomez\",\n  \"dni\": \"{{$timestamp}}\",\n  \"email\": \"ana{{$timestamp}}@mail.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const u = pm.response.json();",
                  "pm.collectionVariables.set(\"usuario_id\", u.id);",
                  "pm.collectionVariables.set(\"dni_usado\", u.dni);",
                  "pm.test(\"Tiene id\", () => pm.expect(u.id).to.be.a(\"number\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar usuarios",
